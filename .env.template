# Copy the backend values to apps/api/.env and the NEXT_PUBLIC_* values to
# apps/web/.env.local. Never commit either file.
POSTGRES_DB=dental
POSTGRES_USER=dental
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://dental:local-development-only@localhost:5432/dental
# Use the Supabase direct connection string for migrations. Runtime can use the
# direct connection or the session pooler on port 5432.
DATABASE_ADMIN_URL=
DB_POOL_MAX=2
DB_APP_ROLE=dental_app
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=kz-local-1
S3_BUCKET=dental-local
S3_ACCESS_KEY=dental-local
S3_SECRET_KEY=local-development-only
AUTH_MODE=supabase
LOCAL_SESSION_HOURS=12
SEED_LOGIN=owner
SEED_EMAIL=owner@example.com
SEED_PASSWORD=replace-with-a-strong-password
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=authenticated
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Optional provider-neutral outbound messaging adapter used by the worker.
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project API. The public key is safe for the browser when RLS is
# correctly configured. New projects should prefer an sb_publishable_* key;
# NEXT_PUBLIC_SUPABASE_ANON_KEY remains supported for legacy projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase API credentials. Prefer SUPABASE_SECRET_KEY. The legacy
# service-role key is only used as a fallback. Never prefix either with
# NEXT_PUBLIC_ and never expose them to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dental-private
