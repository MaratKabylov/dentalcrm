generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 01. PLATFORM & TENANT MANAGEMENT
// -------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  subdomain   String       @unique
  status      TenantStatus @default(TRIAL)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  archivedAt  DateTime?    @map("archived_at")
  archivedBy  String?      @map("archived_by")

  settings      TenantSettings?
  features      TenantFeature[]
  organizations Organization[]
  memberships   Membership[]
  roles         Role[]
  auditEvents   AuditEvent[]
  outboxEvents  OutboxEvent[]
  userSessions  UserSession[]

  @@map("tenants")
}

model TenantSettings {
  id                 String   @id @default(uuid())
  tenantId           String   @unique @map("tenant_id")
  timezone           String   @default("Asia/Almaty")
  currency           String   @default("KZT")
  locale             String   @default("ru")
  dateFormat         String   @default("YYYY-MM-DD")
  allowOnlineBooking Boolean  @default(true) @map("allow_online_booking")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantFeature {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  featureKey String   @map("feature_key")
  isEnabled  Boolean  @default(true) @map("is_enabled")
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  maxBranches   Int      @default(1) @map("max_branches")
  maxChairs     Int      @default(3) @map("max_chairs")
  maxDoctors    Int      @default(5) @map("max_doctors")
  priceMonthly  Decimal  @default(0) @map("price_monthly")
  currency      String   @default("KZT")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  planId    String   @map("plan_id")
  status    String   @default("ACTIVE")
  startsAt  DateTime @default(now()) @map("starts_at")
  endsAt    DateTime @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// -------------------------------------------------------------
// 02. ORGANIZATIONS, BRANCHES, ROOMS & CHAIRS
// -------------------------------------------------------------

model Organization {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  bin          String?  // Kazakhstan Business Identification Number (БИН)
  legalAddress String?  @map("legal_address")
  status       String   @default("ACTIVE")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  name           String
  code           String?
  city           String   @default("Алматы")
  address        String
  phone          String?
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]
  rooms        Room[]
  chairs       Chair[]

  @@map("branches")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("departments")
}

model Room {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  branchId  String   @map("branch_id")
  name      String
  number    String?
  floor     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  chairs Chair[]

  @@map("rooms")
}

enum ChairStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

model Chair {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  branchId             String      @map("branch_id")
  roomId               String      @map("room_id")
  name                 String
  code                 String?
  status               ChairStatus @default(OPERATIONAL)
  isAvailableForBooking Boolean    @default(true) @map("is_available_for_booking")
  version              Int         @default(1)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("chairs")
}

// -------------------------------------------------------------
// 03. IDENTITY & RBAC ACCESS CONTROL
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  iin          String?  // Kazakhstan IIN (ИИН)
  isActive     Boolean  @default(true) @map("is_active")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships  Membership[]
  sessions     UserSession[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id") // Nullable for global system roles
  name        String
  code        String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  domain      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid())
  membershipId String @map("membership_id")
  roleId       String @map("role_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tenantId   String    @map("tenant_id")
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// -------------------------------------------------------------
// 04. IMMUTABLE AUDIT TRAIL
// -------------------------------------------------------------

model AuditEvent {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  actorUserId      String?  @map("actor_user_id")
  actorEmployeeId  String?  @map("actor_employee_id")
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  beforeSnapshot   Json?    @map("before_snapshot")
  afterSnapshot    Json?    @map("after_snapshot")
  reason           String?
  ip               String?
  userAgent        String?  @map("user_agent")
  requestId        String?  @map("request_id")
  hash             String   // Cryptographic SHA-256 tamper-evident hash
  previousHash     String?  @map("previous_hash") // Chain linking for immutable auditing
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  eventType String   @map("event_type")
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  details   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("security_events")
}

// -------------------------------------------------------------
// 05. TRANSACTIONAL OUTBOX
// -------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  eventName    String       @map("event_name")
  payload      Json
  status       OutboxStatus @default(PENDING)
  retryCount   Int          @default(0) @map("retry_count")
  scheduledAt  DateTime     @default(now()) @map("scheduled_at")
  publishedAt  DateTime?    @map("published_at")
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

// -------------------------------------------------------------
// 06. IDEMPOTENCY
// -------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  key            String
  endpoint       String
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
