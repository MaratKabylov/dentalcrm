# PostgreSQL connections from Supabase Dashboard -> Connect.
# Runtime: direct connection or session pooler (port 5432).
DATABASE_URL=
# Migrations: direct connection as the postgres project user.
DATABASE_ADMIN_URL=
DB_POOL_MAX=2
DB_APP_ROLE=dental_app

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is configured.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=dental-private

AUTH_MODE=supabase
LOCAL_SESSION_HOURS=12
SEED_LOGIN=owner
SEED_EMAIL=owner@example.com
SEED_PASSWORD=replace-with-a-strong-password
PORT=4000
WEB_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=authenticated
LOG_LEVEL=info
