# Application Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://dentaladmin:dentalpassword123@localhost:5432/dentalcrm?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3 Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dentalminio
S3_SECRET_KEY=miniopassword123
S3_BUCKET=dentalcrm-storage

# JWT Secret
JWT_SECRET=super-secret-dentalcrm-key-change-in-production-2026
JWT_EXPIRATION=1d

# Default Super Admin Seed
SUPERADMIN_EMAIL=admin@dentalcrm.kz
SUPERADMIN_PASSWORD=AdminSecurePass2026!
